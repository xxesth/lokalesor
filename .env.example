# Kopyala: cp .env.example .env   (web için: cp .env.example apps/web/.env.local)
# Sunucu servisleri (api, worker, realtime) ve db/core script'leri kökteki .env'yi okur.

# --- web ---
# mock: tarayıcı içi sahte arka uç (Faz 1) | http: gerçek api (Faz 2)
NEXT_PUBLIC_DATA_SOURCE=mock

# --- altyapı (docker compose up -d) ---
DATABASE_URL=postgres://lokale:lokale@localhost:5432/lokale
# core entegrasyon testleri bu veritabanını her çalıştırmada sıfırlar
TEST_DATABASE_URL=postgres://lokale:lokale@localhost:5432/lokale_test
REDIS_URL=redis://localhost:6379
# docker compose port değişikliği için (makinende 5432/6379 doluysa)
# POSTGRES_PORT=55432
# REDIS_PORT=56379

# --- iş kuralları ---
# demo: T = 3 dk (ADR-015) | default: T = 30 dk
LOKALE_CONFIG=demo
# "bugün" sınırı (günlük kapasite) bu saat dilimine göre hesaplanır
LOKALE_TZ=Europe/Istanbul

# --- api / realtime ---
BETTER_AUTH_SECRET=degistir
# api imzalar, realtime doğrular (en az 32 karakter)
REALTIME_TOKEN_SECRET=degistir-en-az-32-karakter-olmali-xx
API_PORT=4000
REALTIME_PORT=4001
